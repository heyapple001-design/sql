     , nvl(sc.trafic_09,0) "ТРАФИК СЕНТЯБРЬ" 
     , nvl(sc.trafic_10,0) "ТРАФИК ОКТЯБРЬ"
     , nvl(sc.trafic_11,0) "ТРАФИК НОЯБРЬ" 
     , nvl(sc.trafic_12,0) "ТРАФИК ДЕКАБРЬ"   
