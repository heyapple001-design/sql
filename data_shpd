     , (SELECT COUNT(ipu.srls_srls_id)
          FROM crs.rep_abon_base_dmt_14819_14820_subs ipu
         WHERE ipu.subs_subs_id = sc.subs_id
           AND ipu.serv_parm = 1    
         GROUP BY ipu.subs_subs_id) "ИПУ=1"
    ,  (SELECT COUNT(ipu.srls_srls_id)
          FROM crs.rep_abon_base_dmt_14819_14820_subs ipu
         WHERE ipu.subs_subs_id = sc.subs_id
           AND ipu.serv_parm != 1
         GROUP BY ipu.subs_subs_id) "ИПУ<>1"  
     , (SELECT listagg(ipu.srls_srls_id||'; ') within group (order by ipu.srls_srls_id)
          FROM crs.rep_abon_base_dmt_14819_14820_subs ipu
         WHERE ipu.subs_subs_id = sc.subs_id
           AND ipu.serv_parm != 1
         GROUP BY ipu.subs_subs_id) "СПИСОК SRLS_SRLS_ID"
     , (SELECT listagg(ipu.def||'; ') within group (order by ipu.def)
          FROM crs.rep_abon_base_dmt_14819_14820_subs ipu
         WHERE ipu.subs_subs_id = sc.subs_id
           AND ipu.serv_parm != 1
         GROUP BY ipu.subs_subs_id) "СПИСОК УСЛУГА_С_ПРИМЕНЕНИЕМ_ИПУ"
     , (SELECT listagg(ipu.serv_parm||'; ') within group (order by ipu.serv_parm)
          FROM crs.rep_abon_base_dmt_14819_14820_subs ipu
         WHERE ipu.subs_subs_id = sc.subs_id
           AND ipu.serv_parm != 1
         GROUP BY ipu.subs_subs_id) "СПИСОК ИНДИВИДУАЛЬНЫЙ_ПАРАМЕТР_УСЛУГ"
     , (SELECT listagg(ipu.navi_user||'; ') within group (order by ipu.navi_user)
          FROM crs.rep_abon_base_dmt_14819_14820_subs ipu
         WHERE ipu.subs_subs_id = sc.subs_id
           AND ipu.serv_parm != 1
         GROUP BY ipu.subs_subs_id) "СПИСОК КТО_УСТАНОВИЛ_ИПУ"
     , (SELECT listagg(LPAD(ipu.navi_date, 10)||'; ') within group (order by ipu.navi_date)
          FROM crs.rep_abon_base_dmt_14819_14820_subs ipu
         WHERE ipu.subs_subs_id = sc.subs_id
           AND ipu.serv_parm != 1
         GROUP BY ipu.subs_subs_id) "СПИСОК КОГДА_УСТАНОВИЛ_ИПУ"
