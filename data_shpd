     , nvl(sc.chrg_06,0) "НАЧИСЛЕНИЯ ЗА ИЮНЬ"
     , nvl(sc.chrg_07,0) "НАЧИСЛЕНИЯ ЗА ИЮЛЬ"
     , nvl(sc.chrg_08,0) "НАЧИСЛЕНИЯ ЗА АВГУСТ"
