     , nvl(sc.chrg_10,0)  "НАЧИСЛЕНИЯ ЗА ОКТЯБРЬ"
     , nvl(sc.chrg_11,0)  "НАЧИСЛЕНИЯ ЗА НОЯБРЬ"
     , nvl(sc.chrg_12,0)  "НАЧИСЛЕНИЯ ЗА ДЕКАБРЬ"
     , nvl(sc.cur_balance,0)  "ТЕКУЩИЙ_БАЛАНС"
     , sc.region
