            THEN 'Технологический'
            
            -- =========================================================
            -- 11. ПРОЧИЕ (все, что не попало в категории)
            -- =========================================================
            ELSE 'Прочие'
        END AS tarif_status
   FROM bis.subs_clnt_histories sc
   JOIN bis.client_histories ch 
        ON ch.clnt_clnt_id = sc.clnt_clnt_id
        AND TRUNC (LAST_DAY(ADD_MONTHS(SYSDATE,-1))) BETWEEN ch.start_date AND ch.end_date
        AND ch.hist_jrtp_id = 2
        AND ch.ctyp_ctyp_id NOT IN (4,102,202 )
        AND ch.blgr_blgr_id NOT IN (9)
        AND ch.brnc_brnc_id IN (11,12,14,15,16,17,18)
    JOIN bis.subscribers s
    ON s.subs_id = sc.subs_subs_id
  JOIN bis.subs_histories sh
    ON sh.subs_subs_id = sc.subs_subs_id AND SYSDATE BETWEEN sh.start_date AND sh.end_date 
  JOIN bis.rate_plans rp
    ON rp.rtpl_id = sh.rtpl_rtpl_id  
       AND SYSDATE BETWEEN rp.start_date AND rp.end_date
   JOIN 
   (SELECT  sp_all.subs_subs_id, sp_all.pack_pack_id 
     from
       ( SELECT sp1.subs_subs_id, sp1.pack_pack_id   
         FROM  bis.SUBS_PACKS sp1
         WHERE SYSDATE BETWEEN sp1.start_date AND sp1.end_date 
         UNION ALL 
         SELECT DISTINCT   sp0.subs_id subs_subs_id, 0 AS pack_pack_id  
         FROM  bis.subscribers sp0
         WHERE sp0.stnd_stnd_id in (3, 150)  
        ) sp_all
      ) sp ON sp.subs_subs_id= sc.subs_subs_id   
  LEFT JOIN  bis.packs p on p.pack_id=sp.pack_pack_id     
   WHERE 1 = 1
   AND sc.sbst_sbst_id IN (2,3)
   AND TRUNC (LAST_DAY(ADD_MONTHS(SYSDATE, -1))) BETWEEN sc.start_date AND sc.end_date 
   AND s.stnd_stnd_id in (3, 150)  
  ),
dnumber AS 
   (select /*+ parallel (6) */
   ph.subs_subs_id, ns.msisdn
  from bis.phone_histories ph   
  left join bis.number_sets ns on ns.nset_id=ph.nset_nset_id 
  where (1=1)
  and ph.ncat_ncat_id=1   
  and current_date BETWEEN ph.START_DATE AND ph.END_DATE 
  ),
    clnt as  
  (SELECT /*+ parallel (6) */
    (CASE WHEN ch.hist_jrtp_id=2 THEN 'ЮЛ'
             WHEN ch.hist_jrtp_id=1 THEN 'ФЛ'
             ELSE ''
         END) jrtp_nm
     , ch.brnc_brnc_id    
     , b.name branch_nm
     , ch.clnt_clnt_id
     , ch.name client_name
     , dp1.name rus_nm
     , dp.name ckto_nm
     , ch.account
     , ja.inn
     , (SELECT ctp.def
          FROM bis.client_types ctp
         WHERE ctp.ctyp_id=ch.ctyp_ctyp_id) type_clnt
     , (SELECT dv.def
          FROM bis.client_dictionaries cd
          JOIN bis.dict_values dv ON dv.divl_id = cd.divl_divl_id
         WHERE ch.clnt_clnt_id = cd.clnt_clnt_id
           AND dv.dict_dict_id = 1022
           AND cd.del_user IS NULL) macrosegm
     , (SELECT dv.def
          FROM bis.client_dictionaries cd
          JOIN bis.dict_values dv ON dv.divl_id = cd.divl_divl_id
         WHERE ch.clnt_clnt_id = cd.clnt_clnt_id
           AND dv.dict_dict_id = 1020
           AND cd.del_user IS NULL) segm
     , (SELECT dv.def
          FROM bis.client_dictionaries cd
          JOIN bis.dict_values dv ON dv.divl_id = cd.divl_divl_id
         WHERE ch.clnt_clnt_id = cd.clnt_clnt_id
           AND dv.dict_dict_id = 1021
           AND cd.del_user IS NULL) subsegm
     , (SELECT dv.def
          FROM bis.client_dictionaries cd
          JOIN bis.dict_values dv ON dv.divl_id = cd.divl_divl_id
         WHERE ch.clnt_clnt_id = cd.clnt_clnt_id
           AND dv.dict_dict_id = 150
           AND cd.del_user IS NULL) k_code
 FROM bis.client_histories ch
  JOIN bis.branches b   ON b.brnc_id = ch.brnc_brnc_id
  JOIN bis.departments dp  ON dp.dprm_id = ch.dprm_dprm_id
  LEFT JOIN bis.departments dp1  ON dp1.dprm_id = dp.par_dprm_id
  JOIN bis.dlv_histories dh   ON ch.clnt_clnt_id = dh.clnt_clnt_id AND SYSDATE BETWEEN dh.start_date AND dh.end_date
  JOIN bis.jur_addresses ja  ON ch.clnt_clnt_id = ja.clnt_clnt_id   AND SYSDATE BETWEEN ja.start_date AND ja.end_date
 WHERE 1 = 1
   AND ch.hist_jrtp_id = 2
   AND ch.ctyp_ctyp_id NOT IN (4, 102, 202)
   AND ch.blgr_blgr_id NOT IN (9)
   AND ch.brnc_brnc_id IN (11, 12, 14, 15, 16, 17, 18)
   AND SYSDATE BETWEEN ch.start_date AND ch.end_date
   )
 SELECT
     clnt.jrtp_nm "ФЛ/ЮЛ"
     ,clnt.brnc_brnc_id "КОД ФИЛИАЛА"
     , clnt.branch_nm "РФ"
     , clnt.clnt_clnt_id
     , clnt.account "ЛС"
     , clnt.inn "ИНН"
     , clnt.type_clnt "ТИП_КЛИЕНТА"
     , clnt.macrosegm "МАКРОСЕГМЕНТ"
     , clnt.segm "СЕГМЕНТ"
     , clnt.subsegm "ПОДСЕГМЕНТ"
     , clnt.k_code "ПО МЕТОДИКЕ ГД"
     , clnt.client_name "НАИМЕН_КЛИЕНТА"
     , subs.subs_subs_id "АБОНЕНТ"
     , subs.stnd_stnd_id "СТАНДАРТ"
     , n.msisdn "НОМЕР УСТРОЙСТВА"
     , subs.pack_pack_id "ИД ПАКЕТА"
     , subs.pack_name "ПАКЕТ"
     , subs.name_r "ТАРИФНЫЙ ПЛАН"
     , subs.NAME_1 "АЛЬТЕРНАТИВНОЕ НАЗВАНИЕ"
     , subs.NAME_E "НАЗВАНИЕ НА АНГЛИЙСКОМ"
     , subs.ACTIVE_END "ДАТА ОКОНЧАНИЯ ТАРИФА"
     , subs.tarif_status "СТАТУС ТАРИФНОГО ПЛАНА"
     , subs.RTPL_RTPL_ID "ИД ТАРИФНОГО ПЛАНА"
     , nvl(srls.srls_srls_id,0) "ИД УСЛУГИ"
     , srls.def "УСЛУГА"
     , nvl(srls.serv_parm,0) "ИПУ"
     , srls.navi_user "КТО УСТАНОВИЛ ИПУ"
     , srls.navi_date " КОГДА_УСТАНОВИЛ_ИПУ"
     , nvl(ch.chrg_01,0) "НАЧИСЛЕНИЯ ЗА ЯНВАРЬ"
     , nvl(ch.chrg_02,0) "НАЧИСЛЕНИЯ ЗА ФЕВРАЛЬ"
     , nvl(ch.chrg_03,0) "НАЧИСЛЕНИЯ ЗА МАРТ"
     , nvl(ch.chrg_04,0) "НАЧИСЛЕНИЯ ЗА АПРЕЛЬ"
     , nvl(ch.chrg_05,0) "НАЧИСЛЕНИЯ ЗА МАЙ"
     , nvl(ch.chrg_06,0) "НАЧИСЛЕНИЯ ЗА ИЮНЬ"
     , nvl(ch.chrg_07,0) "НАЧИСЛЕНИЯ ЗА ИЮЛЬ"
     , nvl(ch.chrg_08,0) "НАЧИСЛЕНИЯ ЗА АВГУСТ"
     , nvl(ch.chrg_09,0) "НАЧИСЛЕНИЯ ЗА СЕНТЯБРЬ"
     , nvl(ch.chrg_10,0) "НАЧИСЛЕНИЯ ЗА ОКТЯБРЬ"
     , nvl(ch.chrg_11,0) "НАЧИСЛЕНИЯ ЗА НОЯБРЬ"
     , nvl(ch.chrg_12,0) "НАЧИСЛЕНИЯ ЗА ДЕКАБРЬ"
     , nvl(ch.chrg_01+ch.chrg_02+ch.chrg_03+ch.chrg_04+ch.chrg_05+ch.chrg_06+
       ch.chrg_07+ch.chrg_08+ch.chrg_09+ch.chrg_10+ch.chrg_11+ch.chrg_12,0) "ТЕКУЩИЙ_БАЛАНС"
   FROM subs
   JOIN CLNT ON clnt.clnt_clnt_id=subs.clnt_clnt_id
   LEFT JOIN dnumber n ON n.subs_subs_id = subs.subs_subs_id
   LEFT JOIN srls ON srls.subs_subs_id = subs.subs_subs_id AND srls.pack_pack_id=subs.pack_pack_id
   LEFT JOIN bill_aggregated ch ON ch.CLNT_CLNT_ID =subs.clnt_clnt_id AND ch.subs_subs_id=subs.subs_subs_id --AND ch.srls_srls_id=srls.srls_srls_id 
                           AND  ch.pack_pack_id=subs.pack_pack_id AND ch.rtpl_rtpl_id = subs.rtpl_rtpl_id                           
   WHERE to_char(clnt.brnc_brnc_id) LIKE '~p_branc_id~'
         AND  to_char(subs.stnd_stnd_id) LIKE '~p_stnd_id~'
         AND   subs.rtpl_rtpl_id in (~spisok_rtpl_id~)
    ORDER BY  clnt.brnc_brnc_id, subs.clnt_clnt_id, subs.subs_subs_id
